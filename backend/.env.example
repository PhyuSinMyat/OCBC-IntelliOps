# Use only a synthetic development database.
DATABASE_URL=postgresql+psycopg2://intelliops:change-me@127.0.0.1:5432/intelliops
# Set distinct, nonempty local demo credentials before connecting the frontend.
INTELLIOPS_ANALYST_TOKEN=
INTELLIOPS_ADMIN_TOKEN=
INTELLIOPS_RECONCILIATION_SECONDS=60
# Optional fixed clock. Leave empty for UTC wall time.
INTELLIOPS_SIMULATION_TIME=

# Duplicate investigation: backend only. Both are required; no silent prototype fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
INTELLIOPS_LLM_TIMEOUT_SECONDS=45
