# Use only a synthetic development database.
DATABASE_URL=postgresql+psycopg2://intelliops:change-me@127.0.0.1:5432/intelliops
# Set distinct, nonempty local demo credentials before connecting the frontend.
INTELLIOPS_ANALYST_TOKEN=
INTELLIOPS_ADMIN_TOKEN=
INTELLIOPS_RECONCILIATION_SECONDS=60
# Additional frontend origins, comma-separated. localhost/127.0.0.1:5173 are included.
INTELLIOPS_FRONTEND_ORIGINS=
# Optional fixed clock. Leave empty for UTC wall time.
INTELLIOPS_SIMULATION_TIME=

# Scenario B: explicitly opt in only on a synthetic development/test deployment.
INTELLIOPS_ENVIRONMENT=development
INTELLIOPS_ENABLE_RETRY_FAULT=false
# Comma-separated references for dedicated fictional accounts; empty denies access.
INTELLIOPS_SYNTHETIC_ACCOUNT_REFS=

# Duplicate investigation: backend only. Both are required; no silent prototype fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
INTELLIOPS_LLM_TIMEOUT_SECONDS=45
INTELLIOPS_LLM_MAX_OUTPUT_TOKENS=4000
INTELLIOPS_LLM_MAX_INPUT_CHARS=200000
# Optional backend-only synthetic candidate diagnostics; blank disables local capture.
INTELLIOPS_LLM_DIAGNOSTICS_DIR=
## Enable only after separately approved backend/sql/001_investigation_records.sql deployment.
## False preserves legacy browser-tab reports; durable-history reads return explicit 503.
INTELLIOPS_INVESTIGATION_PERSISTENCE=false
